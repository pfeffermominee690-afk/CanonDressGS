{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canondressgs.subject00.identity_consistency_review.v1",
  "title": "Subject00 identity consistency review event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_sha256",
    "identity_id",
    "garment_id",
    "condition_id",
    "reviewer_id",
    "review_stage",
    "identity_match",
    "face_match",
    "hair_match",
    "body_shape_match",
    "pose_match",
    "camera_match",
    "garment_match",
    "mask_quality",
    "edge_quality",
    "artifact_grade",
    "decision",
    "reject_reason",
    "timestamp",
    "previous_event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "canondressgs.subject00.identity_consistency_review.v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity_id": {"const": "subject00"},
    "garment_id": {"enum": ["O01", "O03", "O04"]},
    "condition_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "review_stage": {"enum": ["REVIEWER_A", "REVIEWER_B", "ADJUDICATOR"]},
    "identity_match": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
    "face_match": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
    "hair_match": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
    "body_shape_match": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
    "pose_match": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
    "camera_match": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
    "garment_match": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
    "mask_quality": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
    "edge_quality": {"enum": ["PASS", "FAIL", "UNCERTAIN"]},
    "artifact_grade": {"type": "integer", "minimum": 0, "maximum": 3},
    "decision": {"enum": ["ACCEPT", "REJECT", "MAYBE"]},
    "reject_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "IDENTITY_DRIFT",
        "FACE_DRIFT",
        "HAIR_DRIFT",
        "SKIN_TONE_DRIFT",
        "BODY_SHAPE_DRIFT",
        "POSE_DRIFT",
        "CAMERA_DRIFT",
        "GARMENT_SEMANTIC_MISMATCH",
        "HAND_OR_FOOT_ANATOMY",
        "MASK_FAILURE",
        "EDGE_FAILURE",
        "BACKGROUND_OR_LIGHTING_DRIFT",
        "TEXT_OR_WATERMARK",
        "OTHER_RECORDED_REASON"
      ]
    },
    "comment": {"type": ["string", "null"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "previous_event_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  },
  "x_decision_policy": {
    "minimum_independent_initial_reviewers": 2,
    "automatic_acceptance_allowed": false,
    "two_accept_votes_required": true,
    "any_initial_reject_resolves_to_reject": true,
    "all_other_complete_pairs_require_human_adjudication": true,
    "vlm_tie_break_forbidden": true,
    "append_only_hash_chain": true,
    "hard_reject_fields": ["identity_match", "face_match", "hair_match", "body_shape_match", "pose_match", "camera_match", "garment_match"]
  }
}
