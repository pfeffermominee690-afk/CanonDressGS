{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canondressgs.local/schemas/full-dataset-v1.json",
  "title": "CanonDressGS Full Dressable Dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_kind", "conditions", "splits", "outfits"],
  "properties": {
    "schema_version": {"const": "canondressgs.full_dataset.v1"},
    "dataset_kind": {"enum": ["official_12x200", "regression"]},
    "supervision_mode": {"enum": ["single_target", "dual_target_region_aware_v1"], "default": "single_target"},
    "fixture_mode": {"type": "boolean"},
    "expected_outfits": {"type": "array", "items": {"type": "string", "pattern": "^O[0-9]{2}$"}},
    "expected_condition_count": {"type": "integer", "minimum": 1},
    "identity_visual_adjudication": {"type": "object"},
    "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
    "splits": {
      "type": "object", "additionalProperties": false, "required": ["train", "val", "test"],
      "properties": {"train": {"type": "array", "items": {"type": "string"}}, "val": {"type": "array", "items": {"type": "string"}}, "test": {"type": "array", "items": {"type": "string"}}}
    },
    "outfits": {"type": "array", "items": {"$ref": "#/$defs/outfit"}}
  },
  "$defs": {
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "mat3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/vec3"}},
    "vec4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "mat4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/vec4"}},
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "source_frame_id", "source_camera_id", "pose", "Rh_raw", "R_global", "Th", "K", "w2c", "c2w", "width", "height", "background", "conventions", "source_checksum"],
      "properties": {
        "condition_id": {"type": "string", "minLength": 1}, "source_frame_id": {"type": "string"}, "source_camera_id": {"type": "string"},
        "pose": {"type": "array", "minItems": 165, "maxItems": 165, "items": {"type": "number"}},
        "Rh_raw": {"$ref": "#/$defs/vec3"}, "R_global": {"$ref": "#/$defs/mat3"}, "Th": {"$ref": "#/$defs/vec3"},
        "K": {"$ref": "#/$defs/mat3"}, "w2c": {"$ref": "#/$defs/mat4"}, "c2w": {"$ref": "#/$defs/mat4"},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "background": {"$ref": "#/$defs/vec3"},
        "conventions": {"type": "object"}, "source_checksum": {"type": "object"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["condition_id", "rgb", "foreground_mask", "clothing_mask"],
      "properties": {
        "condition_id": {"type": "string"},
        "rgb": {"type": "string"},
        "foreground_mask": {"type": "string"},
        "clothing_mask": {"type": "string"},
        "target_edit_rgb": {"type": "string"},
        "target_base_rgb": {"type": "string"},
        "target_edit_mask": {"type": "string"},
        "target_edit_core_mask": {"type": "string"},
        "target_preserve_mask": {"type": "string"},
        "target_transition_mask": {"type": "string"},
        "target_protected_mask": {"type": "string"},
        "target_foreground_mask": {"type": "string"},
        "target_clothing_mask": {"type": "string"},
        "target_old_clothing_mask": {"type": "string"},
        "target_revealed_skin_mask": {"type": "string"},
        "checksums": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "identity_audit_status": {"enum": ["PASS", "WARN", "FAIL"]}
      },
      "allOf": [{
        "if": {"required": ["target_edit_rgb"]},
        "then": {"required": [
          "target_edit_rgb", "target_base_rgb", "target_edit_mask", "target_edit_core_mask",
          "target_preserve_mask", "target_transition_mask", "target_protected_mask",
          "target_foreground_mask", "target_clothing_mask", "target_old_clothing_mask",
          "target_revealed_skin_mask"
        ]}
      }]
    },
    "outfit": {
      "type": "object", "additionalProperties": false, "required": ["outfit_id", "metadata", "observations"],
      "properties": {"outfit_id": {"type": "string", "pattern": "^O[0-9]{2}$"}, "metadata": {"type": "object"}, "teacher": {}, "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}}
    }
  }
}
